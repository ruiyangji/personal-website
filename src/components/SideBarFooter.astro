    <!-- Email -->
    <a
      href="mailto:rj378@cornell.edu"
      class="p-2 rounded-lg hover:text-primary hover:bg-base-300/70 transition-colors"
      aria-label="Email"
      title="Email (rj378@cornell.edu)"
    >
