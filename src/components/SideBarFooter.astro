        <circle cx="6" cy="18" r="2"></circle>
      </svg>
    </a>
  </div>
</div>

<script is:inline>
  function setupThemeToggle() {
    const btn = document.getElementById("theme-toggle-btn");
    const icon = document.getElementById("theme-icon");
    const label = document.getElementById("theme-label");

    function updateLabel(theme) {
      if (icon && label) {
        if (theme === "light") {
          icon.textContent = "☀️";
          label.textContent = "Warm Light";
        } else {
          icon.textContent = "🌙";
          label.textContent = "Night";
        }
      }
    }

    const currentTheme = document.documentElement.getAttribute("data-theme") || "night";
    updateLabel(currentTheme);

    if (btn) {
      btn.onclick = () => {
        const active = document.documentElement.getAttribute("data-theme") || "night";
        const next = active === "night" ? "light" : "night";
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
        updateLabel(next);
      };
    }
  }

  setupThemeToggle();
  document.addEventListener("astro:after-swap", setupThemeToggle);
</script>
