---
import { type BlogSchema } from '../content/config';
import BaseLayout from './BaseLayout.astro';
import dayjs from 'dayjs';
import localizedFormat from 'dayjs/plugin/localizedFormat';
export interface Props extends BlogSchema {}
const {title,description,pubDate,updatedDate,heroImage,badge,tags=[]}=Astro.props;
dayjs.extend(localizedFormat);const displayDate=dayjs(pubDate).format('MMMM D, YYYY');
---
<BaseLayout title={title} description={description} image={heroImage} ogType="article" current="/blog" reading>
  <a class="text-link back-link" href="/blog">← Back to all essays</a>
  <article class="article-content"><header class="article-head">{badge&&<span class="eyebrow">{badge}</span>}<time>{displayDate}</time>{updatedDate&&<span> · Updated {updatedDate}</span>}<h1>{title}</h1>{description&&<p>{description}</p>}<div class="article-byline"><img src="/images/profile.jpg" alt=""/><div><strong>Jerry (Ruiyang) Ji</strong><span>Cornell CS · Systems × AI</span></div><div class="tag-row">{tags.map(tag=><a href={`/blog/tag/${tag}`}>#{tag}</a>)}</div></div></header><div class="prose-content"><slot/></div><footer class="article-footer"><p>Thoughts or questions? <a href="mailto:rj378@cornell.edu">Get in touch ↗</a></p><a class="text-link" href="/blog">More writing ↗</a></footer></article>
</BaseLayout>
