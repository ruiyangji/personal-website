---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BlogTagPage from '../../../../components/react/BlogTagPage';
import { getCollection } from 'astro:content';
import createSlug from '../../../../lib/createSlug';
export async function getStaticPaths({paginate}){const allPosts=await getCollection('blog');const tags=[...new Set(allPosts.flatMap(post=>post.data.tags||[]))];return tags.flatMap(tag=>paginate(allPosts.filter(post=>post.data.tags?.includes(tag)),{params:{tag},pageSize:10}));}
const {page}=Astro.props;const tag=Astro.params.tag;
const posts=page.data.map(post=>({title:post.data.title,description:post.data.description,date:post.data.pubDate.toISOString(),url:`/blog/${createSlug(post.data.title,post.slug)}`,badge:post.data.badge,tags:post.data.tags||[]}));
---
<BaseLayout title={`Writing: ${tag} | Jerry Ji`} current="/blog"><BlogTagPage tag={tag} posts={posts}/></BaseLayout>
