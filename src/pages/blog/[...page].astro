---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogIndexPage from '../../components/react/BlogIndexPage';
import { getCollection } from 'astro:content';
import createSlug from '../../lib/createSlug';
export async function getStaticPaths({ paginate }) {const posts=await getCollection('blog');posts.sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());return paginate(posts,{pageSize:10});}
const {page}=Astro.props;
const posts=page.data.map(post=>({title:post.data.title,description:post.data.description,date:post.data.pubDate.toISOString(),url:`/blog/${createSlug(post.data.title,post.slug)}`,badge:post.data.badge,tags:post.data.tags||[]}));
---
<BaseLayout title="Writing & Notes | Jerry Ji" current="/blog"><BlogIndexPage posts={posts} pageNumber={page.currentPage} totalPages={page.lastPage}/></BaseLayout>
