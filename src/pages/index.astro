---
import BaseLayout from '../layouts/BaseLayout.astro';
import { HomeIntro, HomeAfter } from '../components/react/HomePage';
import Trace2Code from '../components/react/Trace2Code';
import { getCollection } from 'astro:content';
import createSlug from '../lib/createSlug';
const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0,2).map((post) => ({ title:post.data.title, description:post.data.description, date:post.data.pubDate.toISOString(), url:`/blog/${createSlug(post.data.title,post.slug)}`, badge:post.data.badge || 'Essay' }));
---
<BaseLayout current="/"><HomeIntro/><Trace2Code client:visible/><HomeAfter recentPosts={posts}/></BaseLayout>
