---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const recentPosts = posts.slice(0, 2);
---

<BaseLayout sideBarActiveItemID="home">
  <!-- Hero Section -->
  <div class="pb-6 pt-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-4">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>Cornell CS '26 &bull; Building AI Agents & Applications</span>
    </div>

    <div class="flex flex-col-reverse md:flex-row gap-6 items-start justify-between">
      <div class="max-w-2xl">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-base-content mb-3">
          Hi, I'm Jerry Ji
        </h1>

        <p class="text-lg md:text-xl font-medium text-primary mb-3">
          Software engineer at Cornell building AI agents, evaluations, and LLM products.
        </p>

        <p class="text-sm md:text-base text-base-content/80 leading-relaxed mb-4">
          I started with a traditional backend foundation (PayPal, Cornell CMSX), but my work at Meta shifted my focus toward applied AI: 
          <strong>code generation is getting cheap, but making agents reliable in production requires rigorous evaluations, reflection loops, and context tooling.</strong>
        </p>
        <p class="text-sm text-base-content/75 leading-relaxed mb-6">
          Now, I build practical AI applications and evaluation harnesses—from automated reflection pipelines backtesting 2,000+ proposals at Meta to multimodal vision apps like MealsApp.
        </p>

        <div class="flex flex-wrap gap-2.5">
          <a href="/projects" class="btn btn-primary btn-sm">
            View Projects
          </a>
          <a href="/cv" class="btn btn-outline btn-sm">
            Experience & Resume
          </a>
          <a href="/resume.pdf" target="_blank" class="btn btn-ghost btn-sm border border-base-300">
            Download Resume PDF &darr;
          </a>
          <a href="https://github.com/ruiyangji" target="_blank" class="btn btn-ghost btn-sm border border-base-300">
            GitHub &rarr;
          </a>
        </div>
      </div>

      <div class="w-32 h-32 md:w-40 md:h-40 shrink-0 rounded-2xl overflow-hidden ring-2 ring-base-300 shadow-md">
        <img src="/images/profile.jpg" alt="Jerry Ji" class="w-full h-full object-cover" />
      </div>
    </div>
  </div>

  <!-- Key Numbers -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-6 p-4 rounded-xl bg-base-200/40 border border-base-300">
    <div class="text-center p-1.5">
      <div class="text-2xl font-bold text-primary font-mono">150+</div>
      <div class="text-xs text-base-content/70 mt-0.5">Production Diffs @ Meta</div>
    </div>
    <div class="text-center p-1.5">
      <div class="text-2xl font-bold text-emerald-400 font-mono">2,000+</div>
      <div class="text-xs text-base-content/70 mt-0.5">Backtested AI Proposals</div>
    </div>
    <div class="text-center p-1.5">
      <div class="text-2xl font-bold text-cyan-400 font-mono">3,000+</div>
      <div class="text-xs text-base-content/70 mt-0.5">Engineers Supported</div>
    </div>
    <div class="text-center p-1.5">
      <div class="text-2xl font-bold text-purple-400 font-mono">3.8</div>
      <div class="text-xs text-base-content/70 mt-0.5">Cornell CS GPA</div>
    </div>
  </div>

  <!-- The Coherent Story Arc: From Backend to Applied AI -->
  <div class="my-8 p-5 rounded-2xl bg-base-200/40 border border-base-300">
    <h2 class="text-base font-bold text-base-content mb-2 font-mono">How I Think About AI Engineering</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs text-base-content/80 leading-relaxed">
      <div class="p-3 rounded-lg bg-base-300/40">
        <span class="font-semibold text-primary block mb-1">1. Solid Engineering Roots</span>
        Cut my teeth on enterprise Java, 20-year legacy codebases at Cornell, and high-volume billing microservices at PayPal with strict idempotency.
      </div>
      <div class="p-3 rounded-lg bg-base-300/40">
        <span class="font-semibold text-emerald-400 block mb-1">2. Production AI & Evals</span>
        At Meta, saw that the bottleneck isn't generating code—it's evaluating whether agents work in real environments. Built backtesting pipelines and reflection loops.
      </div>
      <div class="p-3 rounded-lg bg-base-300/40">
        <span class="font-semibold text-cyan-400 block mb-1">3. Fast Product Velocity</span>
        Now building user-facing AI products (multimodal vision apps, RL schedulers, developer tools) with rapid prototyping and practical UX.
      </div>
    </div>
  </div>

  <!-- Featured Projects -->
  <div class="my-8">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl font-bold tracking-tight text-base-content">
        Featured Projects
      </h2>
      <a href="/projects" class="text-xs text-primary hover:underline font-mono">All projects &rarr;</a>
    </div>

    <div class="flex flex-col gap-3.5">
      <HorizontalCard
        title="Chronos: Automated AI Evaluation Pipeline"
        subtitle="Meta Internship &bull; Summer 2026"
        desc="Built an automated evaluation harness that backtested 2,000+ historical capacity optimization proposals. Adapted Microsoft's SkillOpt for reflection agent workflows, increasing review adoption from 10% to 70% across 3 orgs."
        url="/projects#meta-chronos"
        badge="Meta Milestone"
        badgeColor="badge-info"
        metrics="70% Adoption across 3 Orgs"
        tags={["AI Agents", "Evaluations", "Reflection Loops", "Python"]}
      />

      <HorizontalCard
        title="MealsApp: AI Meal Prep & Recipe Engine"
        subtitle="Full-Stack AI Project &bull; Sep 2026"
        desc="Serverless PWA using Gemini 2.5 Flash to dynamically rewrite recipes based on live pantry inventory and available cookware. Features Trader Joe's receipt OCR and Google Calendar batch-cooking workflows."
        url="/projects#meals-app"
        badge="AI App"
        badgeColor="badge-accent"
        metrics="Multimodal Vision + LLM"
        tags={["Gemini 2.5", "TypeScript", "Google Drive API", "OCR", "PWA"]}
      />

      <HorizontalCard
        title="RL Cluster Scheduler"
        subtitle="ML / Scheduling &bull; 2026"
        desc="Discrete-event cluster simulator training RL agents for job scheduling. Implemented Action Masking for CPU/Memory constraints (+40% convergence) and a permutation-invariant attention policy that generalizes to 2x larger clusters."
        url="/projects#rl-scheduler"
        badge="Reinforcement Learning"
        badgeColor="badge-warning"
        metrics="Zero-Shot Generalization"
        tags={["PyTorch", "Gymnasium", "PPO", "Attention"]}
      />
    </div>
  </div>

  <!-- Photos / Life Preview -->
  <div class="my-10 p-5 rounded-2xl bg-base-200/40 border border-base-300">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-lg font-bold text-base-content">Outside of Coding</h2>
        <p class="text-xs text-base-content/60">Cooking for friends, traveling, and coastal sunsets</p>
      </div>
      <a href="/life" class="text-xs text-primary hover:underline font-mono">See more &rarr;</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="group rounded-xl overflow-hidden border border-base-300 bg-base-300/40">
        <div class="aspect-[4/3] overflow-hidden">
          <img src="/images/cooking.jpg" alt="Cooking dinner with friends" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
        </div>
        <div class="p-2.5 text-xs text-base-content/80 font-medium">
          Cooking dinner & wine nights
        </div>
      </div>

      <div class="group rounded-xl overflow-hidden border border-base-300 bg-base-300/40">
        <div class="aspect-[4/3] overflow-hidden">
          <img src="/images/travel.jpg" alt="Budapest at night" class="w-full h-full object-cover object-[center_28%] group-hover:scale-105 transition-transform duration-300" />
        </div>
        <div class="p-2.5 text-xs text-base-content/80 font-medium">
          Parliament at night in Budapest
        </div>
      </div>

      <div class="group rounded-xl overflow-hidden border border-base-300 bg-base-300/40">
        <div class="aspect-[4/3] overflow-hidden">
          <img src="/images/sunset.jpg" alt="California coast sunset" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
        </div>
        <div class="p-2.5 text-xs text-base-content/80 font-medium">
          Pacific coast sunsets
        </div>
      </div>
    </div>

    <div class="mt-4 pt-3 border-t border-base-300/60 flex items-center justify-between text-xs text-base-content/60 font-mono">
      <span>🚧 Life section in development mode</span>
      <span>More photos coming soon</span>
    </div>
  </div>

  <!-- Recent Writing -->
  <div class="my-8">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl font-bold tracking-tight text-base-content">
        Writing
      </h2>
      <a href="/blog" class="text-xs text-primary hover:underline font-mono">All essays &rarr;</a>
    </div>

    <div class="flex flex-col gap-3">
      {
        recentPosts.map((post) => (
          <HorizontalCard
            title={post.data.title}
            subtitle={new Date(post.data.pubDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
            desc={post.data.description}
            url={"/blog/" + createSlug(post.data.title, post.slug)}
            target="_self"
            badge={post.data.badge}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
